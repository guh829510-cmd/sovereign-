# Copy to .env and fill in. NEVER commit .env (it's git-ignored).

# --- Coinbase CDP wallet credentials (required) ---
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# --- Network (defaults to base-sepolia; the code enforces it) ---
NETWORK_ID=base-sepolia

# --- Survival thresholds (USD) ---
TERMINATE_BELOW_USD=1.00
CLONE_ABOVE_USD=20.00
CLONE_STAKE_USD=10.00
LOOP_INTERVAL_SECONDS=60

# --- Nominal ETH price so USD thresholds are meaningful on testnet ---
ETH_USD_PRICE=3000

# --- Earning strategy ---
HUSTLE_MODE=paper          # paper (default) | live
# HUSTLE_ROUTERS=0x...,0x... # required for live mode

# --- Infrastructure (real actions are OFF unless armed) ---
AEA_ENABLE_REAL_INFRA=     # set to 1 to allow real DO provisioning/termination
DIGITALOCEAN_TOKEN=        # required only when the above is armed
MAX_LIVING_INSTANCES=3
AEA_REPO_URL=
DROPLET_REGION=nyc1
DROPLET_SIZE=s-1vcpu-1gb
